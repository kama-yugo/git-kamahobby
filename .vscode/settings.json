{
  "java.import.gradle.wrapper.enabled": true,
  "java.configuration.updateBuildConfiguration": "automatic",
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/.idea": true,
    "**/*.iml": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.gradle": true
  },
  "[kotlin]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
